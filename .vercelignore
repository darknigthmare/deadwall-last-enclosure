# Upload exclusions only. Public HTTP files are still selected by scripts/build.mjs.
# Keep package.json, vercel.json, scripts/build.mjs, src/, assets/ and runtime CSS.
artifacts/
outputs/
release/
dist/
coverage/
desktop/
tests/
# Only the two authored JSON inputs below are needed by the inspection compiler.
# Re-open each parent explicitly, then exclude all of its other children.
docs/*
!docs/codex/
docs/codex/*
!docs/codex/suivi-monde2026/
docs/codex/suivi-monde2026/*
!docs/codex/suivi-monde2026/references-metriques2026.json
!docs/codex/suivi-monde2026/OBJECTIFS80.json
.github/
.env*
*.log
AGENTS.md
SOURCE_PROVENANCE.md
DEADWALL_Standalone.html
scripts/package-desktop.mjs
scripts/release-policy.cjs
scripts/verify-desktop-integrity.mjs
scripts/server.mjs

# Local QA and integration history are never uploaded to the public game.
reports/
.qa-tools/
.deadwall*/
.deadwall*-receipt.json
